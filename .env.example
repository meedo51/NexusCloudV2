# NexusCloud Environment Configuration
# Copy this to .env and adjust values

# Application
NODE_ENV=production
PORT=4000

# Security
JWT_SECRET=change-this-to-a-random-64-char-secret-in-production

# Database (SQLite - stored in docker volume)
DB_PATH=/app/data/nexuscloud.db

# File uploads
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800

# CORS
CORS_ORIGIN=*

# Docker ports (host mapping)
BACKEND_PORT=5000
FRONTEND_PORT=9000
