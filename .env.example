# NexusCloud Environment Configuration

# Application
NODE_ENV=production
PORT=4000

# Security
JWT_SECRET=change-this-to-a-random-64-char-secret-in-production

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nexuscloud
DB_USER=nexuscloud
DB_PASSWORD=changeme
DB_SSL=false
DATABASE_URL=postgresql://nexuscloud:${DB_PASSWORD}@postgres:5432/nexuscloud

# File uploads
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=52428800

# CORS
CORS_ORIGIN=*

# Docker ports
BACKEND_PORT=5000
FRONTEND_PORT=9000

# Feature flags
ENABLE_2FA=true
ENABLE_WEBDAV=true
ENABLE_FULLTEXT_SEARCH=true

# WebDAV
WEBDAV_PORT=4001

# pgAdmin (optional)
PGADMIN_EMAIL=admin@nexuscloud.com
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050

# Version pruning
MAX_FILE_VERSIONS=5
VERSION_PURGE_INTERVAL_MS=3600000
PURGE_INTERVAL_MS=86400000
